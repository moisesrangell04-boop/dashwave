# ================================================
# Wave CRM — Production Environment Variables
# Copie para .env e preencha TODOS os valores
# ================================================

# App
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://seudominio.com.br

# Database — use uma senha forte
DATABASE_URL=postgresql://postgres:SENHA_FORTE_AQUI@postgres:5432/wave_crm
POSTGRES_PASSWORD=SENHA_FORTE_AQUI

# Redis — use uma senha forte
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SENHA_REDIS_AQUI

# JWT — gere com: openssl rand -base64 64
JWT_SECRET=GERE_COM_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=GERE_COM_OPENSSL_RAND_BASE64_64_DIFERENTE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local
# Para S3/R2 (opcional):
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=wave-crm-uploads
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.seudominio.com.br

# AI — coloque pelo menos uma chave
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# WhatsApp — Evolution API
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHAVE_EVOLUTION_AQUI
EVOLUTION_WEBHOOK_URL=https://seudominio.com.br/api/webhooks/evolution

# WhatsApp — Meta Cloud API
META_ACCESS_TOKEN=EAAD...token_de_acesso_permanente
META_WEBHOOK_VERIFY_TOKEN=escolha-um-token-secreto-qualquer
META_APP_SECRET=segredo_do_app_meta

# Email (obrigatório para reset de senha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=senha_de_app_gmail
SMTP_FROM=noreply@seudominio.com.br

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Frontend
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api/v1
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_STORAGE_URL=
